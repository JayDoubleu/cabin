<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Cabin</name>
  <summary>Run Fedora GNOME desktops in containers</summary>

  <description>
    <p>
      Cabin runs full Fedora GNOME desktops inside containers and shows them in
      a resizable window. Each desktop starts in a few seconds and behaves
      like a small virtual machine, without emulating hardware.
    </p>
    <p>Features:</p>
    <ul>
      <li>Manage several desktops from one sidebar</li>
      <li>The guest resolution follows the window, or use a fixed size</li>
      <li>Connect from other devices with an RDP client that has clipboard sharing turned off</li>
      <li>Share host directories as read-write or read-only</li>
      <li>Choose hardware or software rendering per desktop</li>
    </ul>
    <p>
      Cabin needs rootless Podman 5 on the host, with the podman.socket user
      service enabled.
    </p>
    <p>
      A container shares the host kernel. Cabin is a configuration boundary,
      not a sandbox for hostile code. Use a virtual machine for that.
    </p>
  </description>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/JayDoubleu/cabin/main/docs/screenshots/main.png</image>
      <caption>A running Fedora desktop in the main window, beside the list of desktops</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/JayDoubleu/cabin/main/docs/screenshots/new-desktop.png</image>
      <caption>Create a desktop with a name, a memory limit, graphics and an image</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/JayDoubleu/cabin/main/docs/screenshots/settings.png</image>
      <caption>Share folders, choose the renderer and allow remote access for each desktop</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/JayDoubleu/cabin/main/docs/screenshots/images.png</image>
      <caption>Build guest images from recipes and remove the images you do not need</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/JayDoubleu/cabin</url>
  <url type="bugtracker">https://github.com/JayDoubleu/cabin/issues</url>

  <developer id="io.github.jaydoubleu">
    <name>Jay W</name>
  </developer>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0" date="2026-10-20">
      <description>
        <p>The first public release.</p>
        <ul>
          <li>Create, configure, start, stop and delete Fedora GNOME desktops</li>
          <li>Show each desktop in a window that the guest resolution follows</li>
          <li>Share host folders, as read-write or read-only</li>
          <li>Give a desktop a render node for hardware rendering</li>
          <li>Reach a desktop from other devices over RDP</li>
          <li>Build and manage guest images from editable recipes</li>
        </ul>
        <p>Audio, clipboard sharing and HiDPI scaling are not done yet.</p>
      </description>
    </release>
  </releases>
</component>

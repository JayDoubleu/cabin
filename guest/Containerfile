# Cabin guest image: a headless Fedora GNOME desktop exposed over RDP.
#
# The container runs systemd as PID 1. systemd starts a user session for the
# "cabin" user. That session runs GNOME Shell with the headless mutter backend,
# and gnome-remote-desktop serves it over RDP.
#
# ---------------------------------------------------------------------------
# EDITING THIS FILE
#
# You are welcome to change it. Sections are marked so you can tell what is
# safe to change from what the desktop needs to work at all:
#
#   [REQUIRED]  Remove it and the desktop will not start, or will start and
#               not accept a connection. Each one says why.
#   [YOURS]     Change freely. Nothing here is load-bearing.
#
# If a desktop stops working after an edit, the fastest way back is to delete
# your recipe and start again from the one Cabin ships.
# ---------------------------------------------------------------------------
#
# Build:
#   podman build -t localhost/cabin-guest:f44 -f guest/Containerfile guest/

# [REQUIRED] Fedora, because everything below is named the way Fedora names it.
# A different distribution needs a different package list and different unit
# names, which is a rewrite rather than an edit.
FROM registry.fedoraproject.org/fedora:44

# [REQUIRED] Marks the image as one of Cabin's.
#
# The image manager lists images by this label and offers only labelled ones
# when a desktop is created. Remove it and your image still builds, and then
# does not appear anywhere in Cabin. Keep it in any image you want to use.
LABEL io.github.jaydoubleu.cabin.guest="true"

# [REQUIRED] The user the desktop runs as.
#
# The id is 1000 so that files in a shared folder belong to the same person
# inside the desktop as outside it.
ARG CABIN_USER=cabin
ARG CABIN_UID=1000

# [REQUIRED] The desktop session itself.
#
# Weak dependencies stay off to keep the image small, so anything the session
# needs is named here. Removing a line from this list is how a desktop ends up
# starting with no way to connect to it:
#
#   systemd, dbus          systemd is PID 1 and everything talks over the bus
#   polkit                 GNOME Shell shows no applications at all without it
#   gnome-shell, mutter    the session, run with the headless backend
#   gnome-remote-desktop   the RDP server Cabin connects to
#   gnome-keyring          holds the RDP credentials
#   pipewire               gnome-remote-desktop will not start without it
#   mesa                   software rendering when no GPU is passed in
#   xwayland               anything not yet ported to Wayland
#   openssl                generates the desktop's TLS certificate at boot
#   fonts                  a monospace font, or every terminal is unreadable
#
# The fonts are not decoration. Fedora's font packages are weak dependencies,
# so with them off the image ends up holding a sans face and nothing else, and
# fontconfig answers "monospace" with that proportional face. A terminal then
# lays every glyph out on a grid the font does not fit, and the text comes out
# spaced like t h i s. Nothing reports it.
RUN dnf -y install --setopt=install_weak_deps=False \
        systemd systemd-container dbus-broker dbus-daemon \
        gnome-shell gnome-session mutter gnome-settings-daemon \
        gnome-remote-desktop \
        gnome-keyring libsecret \
        polkit \
        gsettings-desktop-schemas gnome-desktop4 \
        xdg-desktop-portal xdg-desktop-portal-gnome xdg-user-dirs \
        pipewire pipewire-pulseaudio wireplumber \
        mesa-dri-drivers mesa-libEGL mesa-libGL mesa-vulkan-drivers \
        xorg-x11-server-Xwayland \
        default-fonts-core-sans default-fonts-core-mono default-fonts-core-serif \
        openssl passwd sudo shadow-utils procps-ng iproute curl \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# [YOURS] Applications and tools.
#
# Nothing here is needed for the desktop to run, so this is the list to change.
# It is a separate step from the one above on purpose: editing it rebuilds only
# this layer, which takes seconds, while the session above stays as it is.
#
# gnome-software is the store. It installs Flatpaks into the desktop user's
# home, which is a volume, so applications the user adds survive the desktop
# being recreated.
#
# It does not install RPMs, and that is on purpose. An RPM lands in the
# container's own writable layer, and Cabin recreates the container for every
# settings change, so anything installed that way disappears without warning.
# PackageKit is what gnome-software would use for RPMs, and weak dependencies
# are off, so it does not arrive and the store does not offer it. Use dnf in
# the terminal for a one-off, and put anything worth keeping in the recipe.
RUN dnf -y install --setopt=install_weak_deps=False \
        gnome-console nautilus gnome-text-editor gnome-control-center \
        gnome-software flatpak \
        gnome-calculator gnome-system-monitor gnome-disk-utility file-roller \
        loupe papers gnome-characters gnome-font-viewer gnome-logs \
        adwaita-icon-theme adwaita-cursor-theme \
        vim-minimal less git \
        podman podman-compose fuse-overlayfs \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# [YOURS] Where the store gets applications from.
#
# The file is fetched now and the repository is added to the session later, by
# cabin-flathub.service. It cannot be added here: the store installs into the
# desktop user's home, that home is a volume, and a volume hides whatever the
# build wrote underneath it.
#
# A system wide repository is not a substitute. Applications installed into one
# live in the container's writable layer, which Cabin replaces whenever a
# setting changes, so they would vanish without warning.
RUN mkdir -p /usr/share/cabin \
    && curl -fsSL -o /usr/share/cabin/flathub.flatpakrepo \
        https://dl.flathub.org/repo/flathub.flatpakrepo

# [YOURS] What sits in the dash when the desktop first starts.
#
# Fedora's own default lists Firefox, Calendar and Calculator, none of which
# are installed here, so the dash came up empty and the desktop looked broken.
# GNOME drops an entry that names a missing application without saying so.
# Keep this list to applications the recipe installs.
RUN printf '%s\n' \
        '[org.gnome.shell]' \
        "favorite-apps=['org.gnome.Console.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']" \
        > /usr/share/glib-2.0/schemas/95-cabin-favourites.gschema.override \
    && glib-compile-schemas /usr/share/glib-2.0/schemas/

# [REQUIRED] Units that do not belong in a container.
#
# Some of these would fail, some would hang the boot, and two of them matter
# for a reason that is not obvious: geoclue and rtkit run services with User=,
# which a rootless container cannot set up, and they fail at "step USER" and
# hold up the session. See DESIGN.md section 12.3.
#
# multi-user.target rather than graphical.target, because the session is
# started by cabin-session.target below and not by a display manager.
RUN systemctl mask \
        systemd-remount-fs.service \
        systemd-machine-id-commit.service \
        systemd-hwdb-update.service \
        systemd-udevd.service systemd-udevd-kernel.socket systemd-udevd-control.socket \
        systemd-udev-trigger.service \
        systemd-modules-load.service \
        systemd-random-seed.service \
        dev-hugepages.mount sys-fs-fuse-connections.mount \
        getty.target console-getty.service \
        NetworkManager.service \
        systemd-oomd.service systemd-oomd.socket \
        geoclue.service rtkit-daemon.service \
    && systemctl set-default multi-user.target

# [REQUIRED] The desktop user.
#
# The password here is a placeholder. Cabin replaces it at every boot from the
# CABIN_PASSWORD environment variable, so changing it in this file achieves
# nothing.
#
# Lingering is what lets the user session run without anybody logging in, and
# the whole desktop is that session. Without it the container boots to nothing.
#
# Subordinate ids let the desktop user run rootless Podman of its own. The
# range is inside the container's own user namespace, so it costs nothing on
# the host.
RUN useradd --uid ${CABIN_UID} --create-home --shell /bin/bash \
        --groups wheel ${CABIN_USER} \
    && echo "${CABIN_USER}:cabin" | chpasswd \
    && echo "${CABIN_USER} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/90-cabin \
    && chmod 0440 /etc/sudoers.d/90-cabin \
    && echo "${CABIN_USER}:100000:65536" > /etc/subuid \
    && echo "${CABIN_USER}:100000:65536" > /etc/subgid \
    && loginctl enable-linger ${CABIN_USER} 2>/dev/null || \
       (mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/${CABIN_USER})

# [REQUIRED] Cabin's own scripts and units, which start and configure the
# session. These files sit beside this one in the recipe folder.
#
# systemd/system also carries polkit.service.d, which is what lets polkit start
# here at all. Without it GNOME Shell shows no applications. That file explains
# the chain, which is four steps long and reports nothing.
COPY scripts/ /usr/libexec/cabin/
COPY systemd/system/ /etc/systemd/system/
COPY systemd/user/ /etc/systemd/user/

# [REQUIRED] Turn those units on.
#
# cabin-prepare runs at every boot: it reads the settings Cabin passes in,
# generates the TLS certificate once, and writes the password. The session
# target is enabled --global because it belongs to the user session rather
# than to the system.
RUN chmod +x /usr/libexec/cabin/* \
    && systemctl enable cabin-prepare.service \
    && systemctl enable cabin-host-socket.socket \
    && systemctl --global enable cabin-session.target

# [REQUIRED] Defaults. Cabin overrides these per desktop, so the values here
# only apply when the image is run by hand.
ENV CABIN_WIDTH=1920 \
    CABIN_HEIGHT=1080 \
    CABIN_USER=${CABIN_USER} \
    CABIN_RDP_PORT=3389 \
    CABIN_PASSWORD=cabin

EXPOSE 3389/tcp

# [REQUIRED] systemd shuts down on SIGRTMIN+3, not on SIGTERM. With the default
# signal a stop waits for the whole timeout and then kills the container, so
# the session never shuts down cleanly.
STOPSIGNAL SIGRTMIN+3

# [REQUIRED] systemd is PID 1. Everything above assumes it.
CMD ["/sbin/init"]
